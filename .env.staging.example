# Perfil staging - plantilla sin secretos reales
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080

# Base de datos staging
DB_URL=jdbc:postgresql://staging-db-host:5432/multisport_staging
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

# Frontend staging permitido por CORS
APP_CORS_ALLOWED_ORIGINS=https://staging.example.com

# Swagger/OpenAPI en staging privado
APP_OPENAPI_ENABLED=true
APP_SWAGGER_UI_ENABLED=true
APP_OPENAPI_PUBLIC_ACCESS_ENABLED=true

# Seguridad pre-release
APP_DISABLE_LOCAL_SEED_USERS=true
APP_PERMISSION_GOVERNANCE_WRITE_ENABLED=false
