POSTGRES_DB=multisport_db
POSTGRES_USER=multisport_user
POSTGRES_PASSWORD=multisport_pass
POSTGRES_PORT=5433
BACKEND_PORT=8080
ADMINER_PORT=8081

# Configuracion local por defecto
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_OPENAPI_ENABLED=true
APP_SWAGGER_UI_ENABLED=true
APP_OPENAPI_PUBLIC_ACCESS_ENABLED=true
APP_DISABLE_LOCAL_SEED_USERS=false
APP_PERMISSION_GOVERNANCE_WRITE_ENABLED=false

# Credenciales de prueba creadas por Flyway solo para desarrollo local
LOCAL_ADMIN_USERNAME=devadmin
LOCAL_ADMIN_PASSWORD=admin123

# Staging/prod deben definir secretos fuera del repositorio:
# SPRING_PROFILES_ACTIVE=staging
# DB_URL=jdbc:postgresql://host:5432/database
# DB_USERNAME=replace-me
# DB_PASSWORD=replace-me
# APP_CORS_ALLOWED_ORIGINS=https://staging.example.com
# APP_DISABLE_LOCAL_SEED_USERS=true
